# 1. Enable https://docs.cloud.google.com/billing/docs/reference/rest
# 2. API Key: https://console.cloud.google.com/apis/credentials
#    API restrictions: Cloud Billing
#    Application restrictions: Websites
#    Website restrictions: (5173 is Vite dev, 4173 is Vite preview)
#     • http://127.0.0.1:5173/*
#     • http://localhost:5173/*
#     • http://127.0.0.1:4173/*
#     • http://localhost:4173/*
GCP_BROWSER_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional. Hours to reuse SKUs cached in the browser's localStorage before
# refetching. Defaults to 336 (two weeks); 0 always refetches.
# SKU_CACHE_MAX_AGE_HOURS=336
